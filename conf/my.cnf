[mysqld]
# 允许所有 IP 访问（远程连接需开启，实际安全由 Docker 网络和防火墙控制）
bind-address = 0.0.0.0
# 根据服务器内存和业务并发调整最大连接数
max_connections = 500

# 开启慢查询日志，便于排查性能问题
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow.log
long_query_time = 2

[client]
# 确保客户端连接也使用 utf8mb4，防止导入 SQL 时中文乱码
default-character-set=utf8mb4

[mysql]
default-character-set=utf8mb4
